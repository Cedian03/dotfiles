// Environment — mirrors hypr/modules/environment.lua
// https://niri-wm.github.io/niri/Configuration:-Introduction
//
// Note: niri's `environment` block only affects processes spawned
// by niri (spawn, spawn-at-startup). For shell-level env vars,
// set them in ~/.zshenv or systemd environment.d.

// Electron apps: enable native Wayland
// For Electron < 39, this env var enables Wayland auto-detection.
// For Electron ≥ 39, use --ozone-platform=wayland CLI flag.
// https://niri-wm.github.io/niri/Application-Issues#electron-applications
environment {
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    GTK_IM_MODULE "simple"
}

// The following Hyprland env vars should be set in ~/.zshenv or
// systemd environment.d, NOT here (niri environment does not
// propagate to systemd-launched apps):
//
// Toolkit backend:
//   GDK_BACKEND=wayland,x11,*
//   QT_QPA_PLATFORM=wayland;xcb
//   SDL_VIDEODRIVER=wayland
//   CLUTTER_BACKEND=wayland
//
// XDG:
//   XDG_CURRENT_DESKTOP=niri
//   XDG_SESSION_TYPE=wayland
//   XDG_SESSION_DESKTOP=niri
//
// Qt:
//   QT_AUTO_SCREEN_SCALE_FACTOR=0
//   QT_WAYLAND_DISABLE_WINDOWDECORATION=1
//   QT_QPA_PLATFORMTHEME=qt6ct
//   QT_ENABLE_HIGHDPI_SCALING=0
//
// Nvidia:
//   GBM_BACKEND=nvidia-drm
//   LIBVA_DRIVER_NAME=nvidia
