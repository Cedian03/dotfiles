// https://niri-wm.github.io/niri/Configuration:-Layout

layout {
    // niri uses one gap value (outer gap equivalent)
    gaps 8

    // When to center a column when changing focus
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    border {
        on
        width 1
        active-color   "#c4b5e0"
        inactive-color "#2a2730"
    }

    focus-ring {
        on
        width 1
        active-color   "#c4b5e0"
        inactive-color "#2a2730"
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
        left 8
        right 8
        top 8
        bottom 8
    }
}
