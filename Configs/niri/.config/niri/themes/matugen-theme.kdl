layout {
	background-color "#0e1513"

    focus-ring {
        active-color "#85d6c0"
        inactive-color "#89938f"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#85d6c0"
        inactive-color "#89938f"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#85d6c0"
        inactive-color "#89938f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#85d6c080"
    }
}

overview {
	backdrop-color "#0e1513"
}

recent-windows {
    highlight {
        active-color "#85d6c0"
        urgent-color "#ffb4ab"
    }
}
